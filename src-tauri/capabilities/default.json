{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://*/*" },
        { "url": "http://*:*/*" }
      ]
    },
    "opener:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }]
    }
  ]
}
